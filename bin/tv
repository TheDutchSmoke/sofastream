#!/bin/zsh -f
# Resolve symlinks so this works from both a checkout and Homebrew's bin directory.
export TV_APP_DIR="${0:A:h:h}/app"
export TV_CONFIG_DIR="${TV_CONFIG_DIR:-$HOME/.config/tv}"
export TV_CACHE_DIR="${TV_CACHE_DIR:-$HOME/.cache/tv}"
export TV_STREAM_PORT="${TV_STREAM_PORT:-8765}"
export TV_LAUNCH_LABEL="${TV_LAUNCH_LABEL:-nl.tristan.streamlink-tv}"
export TV_STREAM_LOG="${TV_STREAM_LOG:-/tmp/streamlink-tv.log}"
export TV_STREAM_ERR="${TV_STREAM_ERR:-/tmp/streamlink-tv.err}"
export TV_REMOTE_PYTHON="${TV_REMOTE_PYTHON:-${TV_APP_DIR:h}/remote-venv/bin/python}"
export TV_APPLE_TV_CONFIG="${TV_APPLE_TV_CONFIG:-$TV_CONFIG_DIR/apple-tv.json}"
export TV_ACTIVE_TV_CONFIG="${TV_ACTIVE_TV_CONFIG:-$TV_CACHE_DIR/active-apple-tv.json}"
source "$TV_APP_DIR/tv.zsh"
tv "$@"
